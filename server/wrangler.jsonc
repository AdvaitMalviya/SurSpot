// The room server for Play with friends: one Cloudflare Durable Object per room, reached over a WebSocket at
// /rooms/<code>. It also keeps the anonymous play counts (one Stats object), posted to /events and read at /stats
// with the STATS_KEY secret. Free-plan Durable Objects need SQLite storage, hence new_sqlite_classes.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "surspot-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "STATS", "class_name": "Stats" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Stats"] }
  ],
  "observability": { "enabled": true }
}

// The room server for Play with friends: one Cloudflare Durable Object per room, reached over a WebSocket at
// /rooms/<code>. Free-plan Durable Objects need SQLite storage, hence new_sqlite_classes.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "surspot-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
